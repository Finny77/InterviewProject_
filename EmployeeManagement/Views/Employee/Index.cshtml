 
@{
    
    ViewData["Title"] = "Employee List";
}
 
<link href="~/css/employee.css" rel="stylesheet" />
<div class="row"> 
    <div class="col-md-12" style="text-align:right;">
        <a class="btn btn-primary" href="/Employee/CreateEmployee" >
            Create
        </a>
    </div>
    <br />
    <br />
    <div class="col-md-12">
        <table class="table table-bordered table-hover table-striped align-middle shadow-sm">
            <thead class=" text-center">
                <tr>
                    <td>Id</td>
                    <td>Employee Name</td>
                    <td>Designation</td>
                    <td>EmailAddress</td>
                    <td>MobilePhone</td>
                    <td>DateOfBirth</td>
                    <td>Nationality</td>
                    <td>IsActive</td>
                    <td>Actions</td>
                </tr>
            </thead>
            <tbody>
                @{
                    foreach ( var items in Model)
                    { 
                        <tr>
                            <td>@items.EmployeeId</td>
                            <td>@items.EmployeeName</td>
                            <td>@items.Designation</td>
                            <td>@items.EmailAddress</td>
                            <td>@items.MobilePhone</td>
                            <td>@items.DateOfBirth</td>
                            <td>@items.Nationality</td>
                            <td>
                                @(items.IsActive ? "Active" : "Inactive")
                            </td>
                            <td>
                                <span><a class=" " href="/Employee/CreateEmployee?Id=@items.EmployeeId">Edit</a></span>
                                <span><a class="">Delete</a></span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<script src="~/js/employee.js"></script>